# Copy this file to `.env` and fill in your own server.
#
#   cp .env.example .env
#
# `.env` is gitignored. This file is not, so never put a real address or a
# key in it.
#
# Leave the value empty and the app still works: it scans labels on the
# phone and calls NIH and PubMed directly. You lose the server-side
# classification and the database match.
#
# EXPO_PUBLIC_ variables are compiled into the app bundle, so anyone with
# the .ipa can read this value. It is an address, not a secret. Put real
# credentials on the server, behind the webhook.

EXPO_PUBLIC_HIP_API_BASE=

# Only needed by tools/deploy-classifier.sh: the id of the n8n workflow to
# update. The API key it uses lives in ../.secrets/n8n.env, outside this
# repository, and is never read from here.
N8N_WF_ID=
