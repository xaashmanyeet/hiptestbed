# Dependencies (restored with `npm install`)
node_modules/

# CocoaPods + Xcode build output (restored with `pod install` / a build)
ios/Pods/
ios/build/
ios/.xcode.env.local
ios/*.xcworkspace/xcuserdata/
ios/*.xcodeproj/xcuserdata/
ios/*.xcodeproj/project.xcworkspace/
DerivedData/
*.xcuserstate
*.hmap
*.ipa

# Compiled JS bundle (regenerated on every build)
*.jsbundle

# Expo
.expo/
dist/
web-build/

# Native build caches
android/build/
android/app/build/
android/.gradle/
*.orig.*

# Local scan exports and sample captures
scans/
*.heic

# Secrets and local config. Never commit these.
.env
.env.*
!.env.example
*.pem
.secrets/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editors
.vscode/
.idea/
*.swp
